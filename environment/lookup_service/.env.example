# GTIC Lookup Service — Environment Configuration
# Copy to .env at repo root and fill in all CHANGE_ME values.

# ── Database ──────────────────────────────────────────────────────────────────
database_url=postgresql://intelligence_app:CHANGE_ME@127.0.0.1:5432/intelligence
DB_NAME=intelligence
DB_USER=intelligence_app
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_POOL_MIN_SIZE=3
DB_POOL_MAX_SIZE=15
BATCH_PROCESSING_CHUNK_SIZE=2000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── External APIs ─────────────────────────────────────────────────────────────
ABUSEIPDB_API_KEY=CHANGE_ME
VIRUSTOTAL_API_KEY=CHANGE_ME
OTX_API_KEY=CHANGE_ME
MALWAREBAZAAR_API_KEY=CHANGE_ME
NVD_API_KEY=CHANGE_ME

# ── Rate limits ───────────────────────────────────────────────────────────────
ABUSEIPDB_RATE_LIMIT=0.001
VIRUSTOTAL_RATE_LIMIT=0.25
NVD_RATE_LIMIT=0.67
ABUSEIPDB_LIMIT=50000

# ── Service config ────────────────────────────────────────────────────────────
MAX_IPS_PER_REQUEST=100000
QUERY_TIMEOUT=180
COMMAND_TIMEOUT=180
MAX_WORKERS=25
CACHE_TTL_BUFFER=300
MOCK_API_MODE=False

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
