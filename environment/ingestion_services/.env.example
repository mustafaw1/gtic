# GTIC Ingestion Services — Environment Configuration
# Copy to .env at repo root and fill in all CHANGE_ME values.

# ── OTX ───────────────────────────────────────────────────────────────────────
OTX_API_KEY=CHANGE_ME
OTX_BASE_URL=https://otx.alienvault.com/api/v1
OTX_PULSE_DELAY=3.0

# ── Malware Bazaar ────────────────────────────────────────────────────────────
MALWAREBAZAAR_API_KEY=CHANGE_ME
MALWAREBAZAAR_BASE_URL=https://mb-api.abuse.ch/api/v1
MALWAREBAZAAR_QUERY_LIMIT=1000

# ── NVD ───────────────────────────────────────────────────────────────────────
NVD_API_KEY=CHANGE_ME
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_RATE_LIMIT=0.67

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=intelligence
DB_USER=intelligence_app
DB_PASSWORD=CHANGE_ME

# ── Service config ────────────────────────────────────────────────────────────
BATCH_SIZE=200
MAX_MEMORY_MB=100
SCHEDULE_INTERVAL_HOURS=1
SERVICE_NAME=ingestion-services
SERVICE_PORT=8002

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
