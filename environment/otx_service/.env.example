# GTIC OTX Ingestion Service — Environment Configuration
# Copy to .env at repo root and fill in all CHANGE_ME values.

# ── OTX ───────────────────────────────────────────────────────────────────────
OTX_API_KEY=CHANGE_ME
OTX_BASE_URL=https://otx.alienvault.com/api/v1
OTX_PULSE_DELAY=3.0

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=intelligence
DB_USER=intelligence_app
DB_PASSWORD=CHANGE_ME

# ── Service config ────────────────────────────────────────────────────────────
BATCH_SIZE=200
MAX_MEMORY_MB=100
SCHEDULE_INTERVAL_HOURS=1
SERVICE_NAME=otx-ingestion-service
SERVICE_PORT=8002

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
